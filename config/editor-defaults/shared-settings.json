  "astro.trace.server": "verbose",
  "autoimport.doubleQuotes": true,
  "autoimport.spaceBetweenBraces": false,
  "bracketPairColorizer.depreciation-notice": false,
  "css.lint.vendorPrefix": "ignore",
  "diffEditor.codeLens": true,
