#!/bin/bash
# Merge public-safe editor preferences without replacing private local state.

set -euo pipefail

current="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v jq >/dev/null 2>&1; then
  echo "  ! jq missing; run ./brew.sh first" >&2
  exit 1
fi

merge_objects() {
  local label="$1"
  local live="$2"
  local temp
  shift 2

  mkdir -p "$(dirname "$live")"
  temp="$(mktemp "$(dirname "$live")/.dotfiles-editor-config.XXXXXX")"

  if [ -f "$live" ]; then
    jq -s 'reduce .[] as $item ({}; . * $item)' "$live" "$@" >"$temp"
  else
    jq -s 'reduce .[] as $item ({}; . * $item)' "$@" >"$temp"
  fi

  if [ -f "$live" ] && cmp -s "$live" "$temp"; then
    rm -f "$temp"
    echo "  = $label settings already up to date"
  else
    mv -f "$temp" "$live"
    echo "  + Merged public-safe $label settings"
  fi
}

merge_arrays() {
  local label="$1"
  local live="$2"
  local temp
  shift 2

  mkdir -p "$(dirname "$live")"
  temp="$(mktemp "$(dirname "$live")/.dotfiles-editor-config.XXXXXX")"

  if [ -f "$live" ]; then
    jq -s '
      reduce .[] as $items ([];
        reduce $items[] as $item (.;
          if any(.[]; . == $item) then . else . + [$item] end
        )
      )
    ' "$live" "$@" >"$temp"
  else
    jq -s '
      reduce .[] as $items ([];
        reduce $items[] as $item (.;
          if any(.[]; . == $item) then . else . + [$item] end
        )
      )
    ' "$@" >"$temp"
  fi

  if [ -f "$live" ] && cmp -s "$live" "$temp"; then
    rm -f "$temp"
    echo "  = $label keybindings already up to date"
  else
    mv -f "$temp" "$live"
    echo "  + Merged public-safe $label keybindings"
  fi
}

configure_editor() {
  local label="$1"
  local app_name="$2"
  local user_dir="$3"
  local settings_override="$4"
  local keybindings_override="${5:-}"

  if [ ! -d "/Applications/$app_name" ] && [ ! -d "$HOME/Applications/$app_name" ]; then
    echo "  - Skipped $label (app is not installed)"
    return 0
  fi

  merge_objects \
    "$label" \
    "$user_dir/settings.json" \
    "$current/config/editor-defaults/shared-settings.json" \
    "$settings_override"

  if [ -n "$keybindings_override" ]; then
    merge_arrays \
      "$label" \
      "$user_dir/keybindings.json" \
      "$current/config/editor-defaults/shared-keybindings.json" \
      "$keybindings_override"
  else
    merge_arrays \
      "$label" \
      "$user_dir/keybindings.json" \
      "$current/config/editor-defaults/shared-keybindings.json"
  fi
}

configure_editor \
  "Visual Studio Code" \
  "Visual Studio Code.app" \
  "$HOME/Library/Application Support/Code/User" \
  "$current/config/editor-defaults/vscode-settings.json"

configure_editor \
  "Cursor" \
  "Cursor.app" \
  "$HOME/Library/Application Support/Cursor/User" \
  "$current/config/editor-defaults/cursor-settings.json" \
  "$current/config/editor-defaults/cursor-keybindings.json"
