{
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "terminal": {
    "env": {
      "FIG_NEW_SESSION": "\"1\""
    },
    "font_family": "monospace"
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "sticky_scroll": {
    "enabled": true
  },
  "buffer_font_family": "CommitMono",
  "linked_edits": true,
  "use_on_type_format": true,
  "show_edit_predictions": true,
  "soft_wrap": "editor_width",
  "icon_theme": "Zed (Default)",
  "base_keymap": "Cursor",
  "features": {
    "edit_prediction_provider": "zed"
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "dock": "right"
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Dark"
  }
}
